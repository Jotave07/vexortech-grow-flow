[Unit]
Description=Hype Delivery native Node application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
UMask=0027
WorkingDirectory=/var/www/vexortech/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
EnvironmentFile=/etc/vexortech/vexortech.env
ExecStartPre=/usr/bin/test -r /var/www/vexortech/current/dist/index.html
ExecStartPre=/usr/bin/test -r /var/www/vexortech/current/.output/server/vanilla-server.js
ExecStart=/usr/bin/node .output/server/vanilla-server.js
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
