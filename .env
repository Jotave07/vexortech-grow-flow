NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL proprio
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=hype_delivery
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_MAX=10

# Obrigatorio em producao
JWT_SECRET=

# Storage local
STORAGE_DIR=.data/storage

# Asaas
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_SECRET=

# Evolution API / WhatsApp
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# SMTP opcional para recuperacao de senha
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
