# Runtime proprio Hype Delivery (sem Supabase)
NODE_ENV=production
PUBLIC_APP_URL=https://hypedelivery.com.br

# Obrigatorio: API/backend usa somente PostgreSQL via servidor Node.
DATABASE_URL=postgres://usuario:senha@host:5432/hype_delivery
# Alternativa ao DATABASE_URL:
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=hype_delivery
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_MAX=10

# Obrigatorio em producao. Use um segredo longo e aleatorio.
JWT_SECRET=

# Storage local de imagens/arquivos enviados pela aplicacao.
STORAGE_DIR=/var/www/vexortech-grow-flow/storage

# Asaas
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=production
ASAAS_WEBHOOK_SECRET=

# Evolution API / WhatsApp
EVOLUTION_API_URL=http://127.0.0.1:32773
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=hypedelivery

# SMTP opcional para recuperacao de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hypedelivery.com.br
