NODE_ENV=production
PUBLIC_APP_URL=https://seudominio.com.br
PARTNER_APP_URL=https://parceiros.seudominio.com.br
APP_ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br,https://parceiros.seudominio.com.br
AUTH_FLOW_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Somente Supabase Edge e o snippet Nginx root-only; nunca entregue ao navegador.
EDGE_PROXY_SECRET=gere-32-bytes-aleatorios-em-base64url-43-ou-mais-caracteres
HOST=127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
DATABASE_RUNTIME_ROLE=vexortech_runtime
# Caminho absoluto para o CA do PostgreSQL; quando definido, o app força sslmode=verify-full.
DATABASE_SSL_ROOT_CERT=/etc/vexortech/supabase-root-2021.crt
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SECRET_KEY
# Admin de plataforma e atribuido em profiles/user_roles; e-mail nao concede privilegio.

# Limites do stream SSE do fallback Node (opcionais). Pedidos usam Broadcast
# privado do Supabase Realtime quando a configuracao remota esta habilitada.
REALTIME_MAX_CONNECTIONS=250
REALTIME_MAX_CONNECTIONS_PER_PRINCIPAL=5
REALTIME_MAX_ATTEMPTS_PER_WINDOW=60
REALTIME_RATE_WINDOW_MS=60000
REALTIME_MAX_STREAM_MS=

# Entrega, geocoding e distancia.
GOOGLE_MAPS_API_KEY=

ASAAS_API_KEY=
ASAAS_ENVIRONMENT=production
ASAAS_WEBHOOK_SECRET=

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_AUTOMATION_PHONE=
EVOLUTION_SEND_CUSTOMER_CONFIRMATION=true
