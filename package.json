{
  "name": "hypedelivery",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:vanilla && node .output/server/vanilla-server.js",
    "dev:client": "vite --config vite.vanilla.config.mjs",
    "dev:server:build": "vite build --config vite.vanilla.config.mjs --ssr src/server/vanilla-server.ts --outDir .output/server --emptyOutDir",
    "build": "npm run build:vanilla",
    "build:vanilla:client": "vite build --config vite.vanilla.config.mjs",
    "build:vanilla:server": "npm run dev:server:build",
    "build:vanilla": "npm run build:vanilla:client && npm run build:vanilla:server",
    "preview": "node .output/server/vanilla-server.js",
    "start": "node .output/server/vanilla-server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reconcile-contract-prices": "node scripts/reconcile-contract-prices.mjs",
    "db:check": "node scripts/check-schema.mjs",
    "inventory": "node scripts/inventory-project.mjs docs/project-inventory.csv",
    "optimize:images": "node scripts/optimize-raster.mjs",
    "quarantine:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quarantine-legacy.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.20.0",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
